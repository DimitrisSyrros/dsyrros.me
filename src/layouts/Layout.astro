---
import '../styles/global.css';
import profile from '../data/profile.json';

const { seo, person, experience, skills } = profile;
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
const ogImage = site ? new URL('/og.jpg', site).href : '/og.jpg';
const linkedin = person.links.find((l) => l.label === 'LinkedIn')?.url;
const current = experience.find((e) => !e.hidden && e.end === null);
const technical = skills.find((s) => s.category === 'Technical Skills')?.items ?? [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      name: person.name,
      jobTitle: person.jobTitle,
      description: person.tagline,
      email: `mailto:${person.email}`,
      ...(site && { url: site.href }),
      ...(linkedin && { sameAs: [linkedin] }),
      ...(current && { worksFor: { '@type': 'Organization', name: current.company } }),
      knowsAbout: technical,
    },
    ...(site ? [{ '@type': 'WebSite', name: person.name, url: site.href, inLanguage: seo.lang }] : []),
  ],
};
---

<!doctype html>
<html lang={seo.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0c0e" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="preload" href="/fonts/anton-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/work-sans-latin.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:locale" content={seo.locale} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${person.name}, ${person.jobTitle}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>
    <slot />
  </body>
</html>
