---
import profile from '../data/profile.json';

const { person, sections } = profile;
---

<footer>
  <div class="legal"><span>{sections.footer.tagline}</span><span>© {new Date().getFullYear()} {person.name}</span></div>
</footer>

<style>
  footer { padding: 1.5rem var(--gutter); background: var(--surface); }
  .legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem 1.5rem; font-size: var(--s-small); color: var(--muted); }
</style>
